{
	"name": "markpad",
	"version": "2.8.4",
	"description": "Light as Notepad, elegant as Markdown.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:installer": "tauri dev -- -- --install",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --import tsx \"scripts/*.test.ts\"",
		"test:vitest": "vitest run",
		"test:frontmatter": "node --test --import tsx scripts/editing.test.ts",
		"test:workflows": "node --test --import tsx scripts/export.test.ts scripts/shortcuts.toolbar.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:test-bundle": "node scripts/build-test-bundle.mjs",
		"tauri": "tauri",
		"release": "node scripts/release.mjs"
	},
	"license": "BSD-3-Clause",
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.5.0",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"dompurify": "3.4.17",
		"highlight.js": "^11.11.2",
		"highlightjs-svelte": "^1.0.6",
		"katex": "^0.18.4",
		"mermaid": "^11.16.0",
		"monaco-editor": "^0.55.1",
		"monaco-vim": "^0.4.4",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"eslint": "10.12.0",
		"eslint-plugin-svelte": "3.23.0",
		"jsdom": "^30.0.1",
		"postcss": "8.5.31",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "1.8.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"overrides": {
		"dompurify": "3.4.17",
		"mermaid": {
			"katex": "$katex"
		}
	}
}
