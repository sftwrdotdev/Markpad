{
	"name": "markpad",
	"version": "2.7.3",
	"description": "The Notepad equivalent for Markdown",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:installer": "tauri dev -- -- --install",
		"build": "vite build",
		"preview": "vite preview",
		"test": "node --test --import tsx 'scripts/*.test.ts'",
		"test:frontmatter": "node --test --import tsx scripts/frontMatter.test.ts scripts/frontMatterProseBlock.test.ts",
		"test:workflows": "node --test --import tsx scripts/exportHtml.test.ts scripts/exportOpenPrompt.test.ts scripts/editorToolbar.test.ts scripts/titlebarToolbar.test.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:test-bundle": "node scripts/build-test-bundle.mjs",
		"tauri": "tauri"
	},
	"license": "BSD-3-Clause",
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.5.0",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"dompurify": "3.4.13",
		"highlight.js": "^11.11.1",
		"highlightjs-svelte": "^1.0.6",
		"katex": "^0.16.27",
		"mermaid": "^11.16.0",
		"monaco-editor": "^0.55.1",
		"monaco-vim": "^0.4.4",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^24.13.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tsx": "^4.22.4",
		"typescript": "~5.6.2",
		"vite": "^6.4.3"
	},
	"overrides": {
		"cookie": "0.7.2",
		"dompurify": "3.4.13"
	}
}
